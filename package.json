{
  "name": "attest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "attest": "./src/cli/main.mjs"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:acceptance": "node --test \"test/acceptance/*.test.mjs\"",
    "test:live": "node --test --test-timeout=300000 test/acceptance/live-web.test.mjs",
    "lint": "oxlint src test tools",
    "lint:boundary": "node tools/check-import-boundary.mjs",
    "check": "npm run lint && npm run lint:boundary && npm test && npm run test:acceptance"
  },
  "dependencies": {
    "cli-table3": "0.6.5",
    "commander": "15.0.0",
    "json-stable-stringify": "1.3.0",
    "pg": "8.23.0",
    "picocolors": "1.1.1",
    "playwright": "1.62.1",
    "tinyglobby": "0.2.17",
    "xmlbuilder2": "4.0.3",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "oxlint": "1.78.0"
  }
}
