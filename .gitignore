# dependencies
node_modules/

# secrets, never commit. DB connection strings live here.
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json
gha-creds-*.json

# test scratch directories. Tests create these with mkdtemp and remove them in
# an after hook, but a run that is interrupted, or an automated commit that
# fires mid run, would otherwise sweep them into the repo. That happened on
# 2026-08-17 and put ten SQLite files in a commit.
**/.tmp-*/
test/.tmp-*/
test/acceptance/run-*/
test/acceptance/raw-*/
test/acceptance/phase0*-*/

# run artifacts and evidence bundles
.attest/
artifacts/
runs/
*.har
*.webm
*.trace.zip
test-results/
playwright-report/

# mobile build inputs and outputs
*.apk
*.aab
*.ipa
*.app.zip

# OS and editor
Thumbs.db
Desktop.ini
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/settings.json

# build output
dist/
build/
*.tsbuildinfo

# logs
*.log
npm-debug.log*
.probe/

.env.local
.env.*.local
credentials.json

# Claude Code local overrides (may contain local DB URLs)
.claude/settings.local.json

# The web adapter fallback scratch root, used when a run has no bundle dir.
# It was already leaking into the repo before the cleanup registry existed.
attest-web/

# Internal planning notes. Kept on disk, deliberately NOT published: they are a
# working record that accumulated personal context (project inventory, machine
# details, infrastructure names) and were never written for an audience.
# REQUIREMENTS.md is the exception, because src/selfverify/corpus.mjs reads it to
# validate requirement ids, so a fresh clone needs it to run selfcheck.
.planning/*
!.planning/REQUIREMENTS.md

# Live sweep output, regenerated on every run.
live-sweep-results.json
