[
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "devices",
      "-l"
    ],
    "env": {}
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "wait-for-device"
    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "shell",
      "getprop",
      "sys.boot_completed"
    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "install",
      "-r",
      "-g",
      "C:\\builds\\fixture.apk"
    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "shell",
      "am",
      "start",
      "-W",
      "-n",
      "com.attest.fixture/.MainActivity"
    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "shell",
      "uiautomator",
