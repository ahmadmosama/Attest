    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "pull",
      "/sdcard/ui.xml",
      "C:\\runs\\ui.xml"
    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "shell",
      "input",
      "tap",
      "120",
      "340"
    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "shell",
      "input",
      "text",
      "hello"
    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "exec-out",
      "screencap",
      "-p"
    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "shell",
      "am",
      "force-stop",
      "com.attest.fixture"
    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
