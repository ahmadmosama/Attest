[
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "devices",
      "-l"
    ],
    "env": {}
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "wait-for-device"
    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "shell",
      "getprop",
      "sys.boot_completed"
    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "install",
      "-r",
      "-g",
      "C:\\builds\\fixture.apk"
    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "shell",
      "am",
      "start",
      "-W",
      "-n",
      "com.attest.fixture/.MainActivity"
    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "shell",
      "am",
      "start",
      "-W",
      "-a",
      "android.intent.action.VIEW",
      "-d",
      "'attest-fixture://customers'",
      "-n",
      "com.attest.fixture/.MainActivity",
      "--es",
      "attest_api_base",
      "'http://10.0.2.2:54321'"
    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "shell",
      "uiautomator",
      "dump",
      "/sdcard/ui.xml"
    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "exec-out",
      "cat",
      "/sdcard/ui.xml"
    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "pull",
      "/sdcard/ui.xml",
      "C:\\runs\\ui.xml"
    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "shell",
      "input",
      "tap",
      "120",
      "340"
    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "shell",
      "input",
      "swipe",
      "540",
      "1600",
      "540",
      "400",
      "300"
    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "shell",
      "input",
      "text",
      "'hello world'"
    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "shell",
      "input",
      "keyevent",
      "KEYCODE_MOVE_END",
      "KEYCODE_DEL"
    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "exec-out",
      "screencap",
      "-p"
    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "shell",
      "screenrecord",
      "--time-limit",
      "180",
      "/sdcard/rec.mp4"
    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "shell",
      "rm",
      "-f",
      "/sdcard/rec.mp4"
    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "shell",
      "am",
      "force-stop",
      "com.attest.fixture"
    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  },
  {
    "command": "/opt/android/platform-tools/adb",
    "args": [
      "-s",
      "emulator-5554",
      "emu",
      "kill"
    ],
    "env": {
      "ANDROID_SERIAL": "emulator-5554"
    }
  }
]
