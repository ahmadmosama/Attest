[
  {
    "name": "session capabilities",
    "value": {
      "surface": "ios",
      "runner": "simulator",
      "xcode": {
        "version": "16.2",
        "developerDir": "/Applications/Xcode_16.2.app/Contents/Developer"
      },
      "runtime": {
        "name": "iOS",
