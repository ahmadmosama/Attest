        "assert_runtime",
        "boot_simulator",
        "install_app",
        "launch_app",
        "screenshot",
        "shutdown"
      ]
    }
  },
  {
    "name": "list runtimes",
    "value": {
      "command": "xcrun",
      "args": [
        "simctl",
        "list",
        "runtimes",
        "available"
      ],
      "env": {
        "DEVELOPER_DIR": "/Applications/Xcode_16.2.app/Contents/Developer",
        "ATTEST_XCODE_VERSION": "16.2",
        "ATTEST_IOS_RUNTIME": "iOS 18.2"
      }
    }
  },
