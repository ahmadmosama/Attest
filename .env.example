# Database capture uses a direct PostgreSQL session connection on port 5432, never the Supabase transaction pooler on 6543.
# ATTEST_DB_URL=postgres://attest_user:fake_password@db.example.test:5432/app_test

# Local development database used by the Postgres tests.
# Without this the Postgres tests SKIP CLEANLY, so the suite stays green with no database.
# With it they run for real against a server that must have wal_level=logical.
# The local Supabase container publishes 5432 on host port 54322.
# ATTEST_PG_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
